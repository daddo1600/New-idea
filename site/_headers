# Cloudflare Pages response headers (GitHub Pages ignores this file).
# connect-src / form-action allow https: so the waitlist form can reach your email provider.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self' https:; form-action 'self' https:; frame-ancestors 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

/assets/*
  Cache-Control: public, max-age=86400

/data/*
  Cache-Control: no-cache
