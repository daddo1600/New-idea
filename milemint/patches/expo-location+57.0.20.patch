+// Core Location can still deliver a queued callback (such as an authorization
+// change) to a manager after its owner lets it go, which crashed with
+// EXC_BAD_ACCESS in -[CLLocationManager onClientEventAuthStatus:]. Retired
+// managers are detached and kept alive on the main queue for a while, so any
+// callback already queued finds a live object, and are released on main.
+static void EXRetireRequesterLocationManager(CLLocationManager *manager)
+{
+  if (manager == nil) {
+    return;
+  }
+  // Core Location delivers callbacks on the main thread, so detaching there
+  // straight away leaves no moment where a callback can reach a freed delegate.
+  if ([NSThread isMainThread]) {
+    manager.delegate = nil;
+  }
+  dispatch_async(dispatch_get_main_queue(), ^{
+    manager.delegate = nil;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+      [manager self];
+    });
+  });
+}
+
 @implementation EXBaseLocationRequester
 
+// Requesters are registered each time the location module is created, which
+// replaces (and frees) the previous ones. A freed requester can still be its
+// manager's delegate when an authorization change arrives (the delegate isn't
+// retained), which crashed in -locationManagerDidChangeAuthorization:. They are
+// small and few, so keep every one alive for the life of the app.
+- (instancetype)init
+{
+  if (self = [super init]) {
+    static NSMutableArray *everyRequester;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+      everyRequester = [NSMutableArray new];
+    });
+    @synchronized (everyRequester) {
+      [everyRequester addObject:self];
+    }
+  }
+  return self;
+}
+
+- (void)dealloc
+{
+  EXRetireRequesterLocationManager(_locationManager);
+}
