+/**
+ One long-lived manager, made on the main thread, for reading the last known
+ location. A throwaway manager created and freed on a background thread could
+ be released while Core Location still had a callback queued for it.
+ */
+@MainActor
+private enum LastKnownLocation {
+  static let manager = CLLocationManager()
+
+  static func current() -> CLLocation? {
+    return manager.location
+  }
+}
