     manager.desiredAccuracy = options.accuracy.toCLLocationAccuracy()
     manager.delegate = self
   }
+
+  // Released providers can be deallocated off the main thread while Core
+  // Location still has a callback (such as an authorization change) queued for
+  // their manager. Detach it and keep it alive on the main queue for a while,
+  // so it is never freed under a pending callback.
+  deinit {
+    let retired = manager
+    DispatchQueue.main.async {
+      retired.delegate = nil
+      DispatchQueue.main.asyncAfter(deadline: .now() + 10) {
+        withExtendedLifetime(retired) {}
+      }
+    }
+  }
 }
diff --git a/node_modules/expo-location/ios/Requesters/EXBaseLocationRequester.m b/node_modules/expo-location/ios/Requesters/EXBaseLocationRequester.m
index 350eb5f..83c7015 100644
--- a/node_modules/expo-location/ios/Requesters/EXBaseLocationRequester.m
+++ b/node_modules/expo-location/ios/Requesters/EXBaseLocationRequester.m
@@ -13,6 +13,24 @@
 
 @end
 
+// Core Location can still deliver a queued callback (such as an authorization
+// change) to a manager after its owner lets it go, which crashed with
+// EXC_BAD_ACCESS in -[CLLocationManager onClientEventAuthStatus:]. Retired
+// managers are detached and kept alive on the main queue for a while, so any
+// callback already queued finds a live object, and are released on main.
+static void EXRetireRequesterLocationManager(CLLocationManager *manager)
+{
+  if (manager == nil) {
+    return;
+  }
+  dispatch_async(dispatch_get_main_queue(), ^{
+    manager.delegate = nil;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+      [manager self];
+    });
+  });
+}
