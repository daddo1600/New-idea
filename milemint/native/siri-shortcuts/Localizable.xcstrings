    "Open MileSprout once, then ask again.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার MileSprout খুলুন, তারপর আবার জিজ্ঞেস করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre MileSprout una vez y vuelve a preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez MileSprout une fois, puis redemandez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार MileSprout खोलें, फिर दोबारा पूछें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਵਾਰ MileSprout ਖੋਲ੍ਹੋ, ਫਿਰ ਦੁਬਾਰਾ ਪੁੱਛੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz raz MileSprout i zapytaj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o MileSprout uma vez e pergunte de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide MileSprout o dată, apoi întreabă din nou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开一次 MileSprout，然后再问。"
          }
        }
      }
    },
