{
  "expo": {
    "name": "MileMint",
    "slug": "mile-mint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "milemint",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.milemint.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B7A55",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.milemint.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B7A55",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MileMint logs your drives automatically in the background, so you never miss a deductible mile. Your trips are stored encrypted on your phone.",
          "locationWhenInUsePermission": "MileMint uses your location to log your drives and label where they started and ended.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "motionUsagePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "get-mile-mint",
    "extra": {
      "eas": {
        "projectId": "f7b2a4a4-a643-4b9a-a09f-101f566e0414"
      }
    }
  }
}
