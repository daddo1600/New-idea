{
  "expo": {
    "name": "MileMint",
    "slug": "mile-mint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "milemint",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.milemint.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": ["iCloud.com.milemint.app"],
        "com.apple.developer.icloud-services": ["CloudDocuments"],
        "com.apple.developer.ubiquity-container-identifiers": ["iCloud.com.milemint.app"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B7A55",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.milemint.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B7A55",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MileMint logs your drives automatically in the background, so you never miss a deductible mile. Your trips are stored encrypted on your phone.",
          "locationWhenInUsePermission": "MileMint uses your location to log your drives and label where they started and ended.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "motionUsagePermission": "MileMint does not use motion data. Drives are detected from location only."
        }
      ],
      "expo-iap",
      "./plugins/without-push-entitlement",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "get-mile-mint",
    "extra": {
      "eas": {
        "projectId": "f7b2a4a4-a643-4b9a-a09f-101f566e0414"
      }
    }
  }
}
